{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "channel": "chrome",
      "headless": true,
      "args": ["--use-angle=swiftshader", "--enable-unsafe-swiftshader"]
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 800 }
    }
  },
  "outputDir": "output/playwright"
}
